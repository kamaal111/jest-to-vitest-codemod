{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-constant-condition": "off",
    "typescript/no-require-imports": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["node_modules/**/*", "dist/**/*"]
}
