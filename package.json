{
  "name": "@kamaalio/jest-to-vitest-codemod",
  "version": "0.0.2",
  "bugs": "https://github.com/kamaal111/jest-to-vitest-codemod/issues",
  "license": "MIT",
  "author": "Kamaal Farah",
  "repository": "kamaal111/jest-to-vitest-codemod",
  "bin": {
    "jest-to-vitest-codemod": "./bin/run.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:u": "vitest run --update",
    "build": "pnpm run compile",
    "clean:build": "rm -rf dist tsconfig.tsbuildinfo && pnpm run build",
    "compile": "tsc",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc --noEmit --project tsconfig.test.json",
    "type-check:scripts": "tsc --noEmit --project tsconfig.scripts.json",
    "lint": "oxlint src tests scripts vitest.config.ts",
    "lint:example": "oxlint --config example/.oxlintrc.json example/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "example:transform-check": "node ./scripts/example-transform-check.ts",
    "quality": "pnpm run lint && pnpm run format:check && pnpm run type-check && pnpm run type-check:test && pnpm run type-check:scripts",
    "ready": "pnpm run quality && pnpm run test:cov && pnpm run example:transform-check",
    "prepare": "husky"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.45.1",
    "@kamaalio/codemod-kit": "^0.0.45",
    "@kamaalio/kamaal": "^0.9.11",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
