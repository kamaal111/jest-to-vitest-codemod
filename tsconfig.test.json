{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    /* Tests import source modules by extensionless path, which Node16 resolution rejects. */
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts"]
}
