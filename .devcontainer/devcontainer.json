{
  "name": "${localWorkspaceFolderBasename}",
  "dockerComposeFile": ["docker-compose.code.yml"],
  "service": "code",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "initializeCommand": "bash .devcontainer/prepare-github-copilot-auth.sh",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "postCreateCommand": "just post-dev-container-create",
  "mounts": [
    "source=${localEnv:HOME}/.codex,target=/home/node/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.copilot,target=/home/node/.copilot,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/node/.config/gh,type=bind,consistency=cached"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "[javascript]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        },
        "[typescript]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        },
        "[jsonc]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        }
      },
      "extensions": [
        "skellock.just",
        "streetsidesoftware.code-spell-checker",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens",
        "aaron-bond.better-comments",
        "github.copilot",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "oxc.oxc-vscode"
      ]
    }
  },
  "features": {
    "ghcr.io/guiyomh/features/just:0": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  }
}
